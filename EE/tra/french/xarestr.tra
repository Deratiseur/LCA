@1909=~Excellent...~ [xalc8404]
@1910=~Hm ?~
@1911=~Qu'y a-t-il ?~
@1912=~Vous êtes satisfaite des améliorations apportées à votre arc, j'imagine ?~
@1913=~La corde magique — j'ai suffisamment observé l'enchantement de remplacement pour pouvoir désormais le faire moi-même.~
@1914=~Je vois.~
@1915=~Bon à savoir.~
@1916=~Vous voulez dire que vous ne pouviez pas le faire avant ?~
@1917=~J'ai changé la corde de mon arc un nombre incalculable de fois, mais jamais par une corde enchantée. Il faut accorder la corde à l'arc, sinon l'enchantement ne peut pas prendre.~ [xalc8431]
@1918=~Maintenant que je comprends le procédé, je pourrai remplacer la corde de l'arc par celle-ci, ou peut-être par d'autres cordes enchantées. Cela prend toutefois du temps, et je ne pourrais pas le faire en plein combat.~
@1919=~Je vois.~
@1920=~Bon à savoir.~
@1921=~Les autres nous attendent. En route.~ [xalc8432]
@1922=~Remplacer la corde de Gond par la corde ordinaire.~
@1923=~Remplacer la corde de Gond par la corde de Gesen.~
@1924=~Remplacer la corde de Gesen par la corde ordinaire.~
@1925=~Remplacer la corde de Gesen par la corde de Gond.~
@1926=~Remplacer la corde ordinaire par la corde de Gond.~
@1927=~Remplacer la corde ordinaire par la corde de Gesen.~
@1928=~Laisser tomber. Ne pas modifier l'arc.~
@1929=~Quels sont vos ordres, héros ?~ [xad10046]
@1930=~Très bien.~ [xad10043]
@1931=~Nous avons du travail. En route.~ [xad10023]
@1932=~(Elle ajuste la corde de son arc.)~ [xalc7024]
@1933=~Vos ordres ?~ [xad10038]
